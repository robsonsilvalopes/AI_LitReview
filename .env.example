APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Opcional: string de ligação única (Coolify, Docker, etc.). Se definido, o Laravel usa DB_URL para mysql.
# DB_URL="mysql://user:password@127.0.0.1:3306/database"

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 (AWS ou compatível). Para MinIO em Docker: FILESYSTEM_DISK=s3, AWS_ENDPOINT, AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# E-mails (separados por vírgula) que podem abrir o painel do Pulse em /pulse; vazio = ninguém.
PULSE_ADMIN_EMAILS=

# Busca de PDFs de acesso aberto por DOI (Final Selection). O Unpaywall só é consultado com um e-mail de contato:
# o informado pelo usuário na janela da busca ou, se vazio, este.
UNPAYWALL_EMAIL=
# Chave da API do CORE (core.ac.uk), usada quando o usuário não informa a sua na janela da busca.
CORE_API_KEY=
PDF_DOWNLOAD_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
